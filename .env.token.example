# TOKEN local stack (docker-compose.token.yml). Copy to .env (gitignored) and
# replace every placeholder. Generate values with: openssl rand -hex 32
# Never commit real values.

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Same value on every node in a cluster.
SESSION_SECRET=change-me
# Same value on every node sharing Redis.
CRYPTO_SECRET=change-me
# TOKEN_HTTP_PORT=3000

# Transactional email (Postmark SMTP), applied to the console's SMTP settings.
# Production values come from the secret manager. Local dev uses Mailpit
# and needs none of these.
# TOKEN_POSTMARK_SERVER_TOKEN=change-me
# TOKEN_EMAIL_FROM=no-reply@mail.thetoken.dev

# Local Grafana (optional observability stack)
# GRAFANA_ADMIN_PASSWORD=change-me

# Local end-to-end tests only. Leave unset otherwise.
# TOKEN_STRIPE_API_BASE=http://mock-stripe:12111   # Stripe calls go to mock-stripe; live keys refused
# CRITICAL_RATE_LIMIT=500                          # repeated test runs from one IP (production: 20)

# Moyasar (Saudi Arabia, SAR) top-ups. Keys come only from the environment.
# Test mode: sk_test_/pk_test_ keys from the Moyasar dashboard. The webhook
# secret is the "Secret Token" set on the Moyasar webhook
# (https://<domain>/api/moyasar/webhook; events payment_paid,
# payment_captured, payment_refunded). The secret and publishable keys must be
# the same mode.
# MOYASAR_SECRET_KEY=sk_test_change-me
# MOYASAR_PUBLISHABLE_KEY=pk_test_change-me
# MOYASAR_WEBHOOK_SECRET=change-me
# MOYASAR_MIN_TOPUP=5
